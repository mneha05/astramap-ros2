<?xml version="1.0"?>
<package format="3">
  <name>astra_slam</name>
  <version>0.1.0</version>
  <description>ROS 2 LiDAR-radar fusion SLAM with a GPU-backed OpenGL viewer.</description>
  <maintainer email="mahesh54@purdue.edu">Neha Mahesh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>libglfw3-dev</depend>
  <depend>libglew-dev</depend>
  <depend>libgl1-mesa-dev</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
